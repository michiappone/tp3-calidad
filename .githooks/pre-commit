#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1
# Evita probar una copia de trabajo distinta de lo preparado para el commit.
if ! git diff --quiet -- src tests pyproject.toml requirements-dev.txt .githooks; then
    echo "ERROR: agregá los cambios pendientes con git add antes de validar."
    exit 1
fi
for ruta in src tests; do
    if [ -n "$(git ls-files --others --exclude-standard -- "$ruta")" ]; then
        echo "ERROR: hay archivos nuevos sin agregar en $ruta."
        exit 1
    fi
done
echo "[1/3] Formatter: Black"
python -m black --check src tests || { echo "Formato incorrecto. Commit cancelado."; exit 1; }
echo "[2/3] Linter: Ruff"
python -m ruff check src tests || { echo "Linter fallido. Commit cancelado."; exit 1; }
echo "[3/3] Pruebas y cobertura mínima 80 %"
python -m pytest || { echo "Pruebas o cobertura fallidas. Commit cancelado."; exit 1; }
echo "Controles aprobados."
